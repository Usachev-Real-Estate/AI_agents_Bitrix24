# ============================================
# Bitrix24
# ============================================
B24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your-webhook-code/
B24_USER_ID=1

# ID воронок сделок (Настройки → CRM → Воронки)
BUYERS_CATEGORY_ID=18
SELLERS_CATEGORY_ID=0

# Дата начала отчётного периода (YYYY-MM-DD)
REPORT_SINCE=2026-06-02

# ============================================
# RouterAI (российский шлюз к DeepSeek)
# ============================================
ROUTERAI_API_KEY=sk-your-routerai-key
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_R1_MODEL=deepseek/deepseek-v4-flash
ROUTERAI_V3_MODEL=deepseek/deepseek-v4-flash

# ============================================
# Режим работы
# ============================================
# DRY_RUN=true — только чтение, без мутаций в Битрикс24
DRY_RUN=true
LOG_LEVEL=INFO

# ============================================
# Уведомления
# ============================================
MANAGEMENT_CHAT_ID=chat12345
ADMIN_USER_ID=1
