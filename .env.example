# ============================================
# Bitrix24
# ============================================
B24_WEBHOOK_URL=https://your-domain.bitrix24.ru/rest/1/your-webhook-code/
B24_USER_ID=1

# ID воронок сделок (Настройки → CRM → Воронки)
BUYERS_CATEGORY_ID=18
SELLERS_CATEGORY_ID=0

# Дата начала отчётного периода (YYYY-MM-DD)
REPORT_SINCE=2026-06-02

# ============================================
# LLM API (OpenAI-compatible, RouterAI)
# https://routerai.ru
# ============================================
LLM_API_KEY=your-routerai-api-key
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_MODEL=google/gemini-3.7-flash
# Резервная модель (пока не используется в коде)
LLM_V3_MODEL=google/gemini-3.7-flash
# Потолок ответа. Наш ответ — JSON фиксированной схемы; лимит стоит не ради
# экономии на норме, а чтобы сорвавшаяся генерация не выставила большой счёт.
# 0 — не ограничивать.
LLM_MAX_TOKENS=16000
# Бюджет «размышлений»: minimal / low / medium / high. Пусто = дефолт
# провайдера.
#
# ВНИМАНИЕ: работает ли это у RouterAI — НЕ ПРОВЕРЕНО. На странице модели
# в списке поддерживаемых параметров стоят `reasoning` и `include_reasoning`,
# а `reasoning_effort` — то, что отправляем мы, — не назван. Значение может
# молча игнорироваться. Прежде чем считать экономию, убедитесь по выгрузке,
# что доля размышлений реально упала.
#
# У RouterAI это самая дорогая строка тарифа: 421 ₽/1М, как выход, против
# 8,5 ₽/1М за чтение кеша. За 01.09.2026 размышления составили 309 ₽ из
# 782 — 58 % выходных токенов на задаче «выпиши факты с цитатами по схеме».
# Сколько их тратится, видно в логе прогона.
#
# Прежде чем менять — прочти порядок опыта в plans/qc-client-state-rules.md
# (§6). Вслепую нельзя: экономить на качестве разбора мы не собирались, а
# просадку видно только сравнением вердиктов.
LLM_REASONING_EFFORT=
# Режим обработки RouterAI: flex / priority / пусто (обычный).
#
# flex — «обычно −50 %» по их документации, ценой скорости и «без гарантий
# по мощностям». Для QC это выгодная сделка: прогон идёт по крону в полдень,
# занимает двадцать минут и никто его не ждёт. Модель та же, ответ тот же —
# платим временем планирования, а не качеством разбора.
#
# Отказ по мощностям не страшен: карточка тут же повторяется в обычном
# режиме, и llm_error засчитывается, только если упали обе попытки. За
# неудачный flex провайдер не списывает, поэтому худший случай по деньгам —
# обычная цена, лучший — вдвое меньше.
LLM_SERVICE_TIER=
# Закреплённый провайдер RouterAI. Пусто — не закреплять (тогда RouterAI
# сам распределяет нагрузку, «отдавая приоритет низкой цене»).
#
# Закреплять надо ради КЭША: неявный кэш префикса живёт у провайдера, и
# запросы, разбросанные между Google AI Studio и Vertex, не попадают в него
# почти никогда. Наша постоянная часть — 2452 токена при пороге Gemini Flash
# в 1024, то есть попадать было некуда, а не нечем.
#
# Значение для боя: google-ai-studio. Не по вкусу — у Google Vertex в
# ответе /endpoints НЕТ параметра temperature, а мы шлём 0.1 безусловно.
# На Vertex это либо отказ, либо молча другая температура, то есть другой
# разбор.
#
# Теги берутся отсюда:
#   GET /api/v1/models/google/gemini-3.7-flash/endpoints
LLM_PROVIDER=
# Тариф RouterAI для google/gemini-3.7-flash, ₽ за 1М токенов. Сверен с
# выгрузкой за 01.09.2026 до копейки. Прежние 40/202 занижали счёт вдвое.
# Выход дороже входа ровно впятеро, чтение кеша — вдесятеро дешевле входа.
# ВАЖНО: значения из .env перекрывают дефолты config.py — если эти строки
# в боевом .env остались старыми, прогон продолжит печатать половину счёта.
LLM_PRICE_INPUT=84.2198
LLM_PRICE_OUTPUT=421.099
# Кэш входа: чтение — десятая доля входа (на витрине RouterAI округлено до
# «8 ₽», как и вход до «84»); запись — со страницы модели, дешевле чтения и
# в 18 раз дешевле свежего входа, то есть кэш окупается с первого повторения.
# Выгрузкой не проверено: закэшированных токенов у провайдера пока ноль.
LLM_PRICE_CACHE_READ=8.42198
LLM_PRICE_CACHE_WRITE=4.68
# Старые имена DEEPSEEK_* тоже читаются для обратной совместимости

# ============================================
# Режим работы
# ============================================
# DRY_RUN=true — только чтение, без мутаций в Битрикс24
DRY_RUN=true
# Пусто = перенос сразу. ISO-дата — не переносить сделки/лиды до этого момента
# (нарушения в чаты всё равно уходят). Пример: 2026-08-13T19:00:00+03:00
# Дата в будущем — временная пауза автопереноса.
GENERAL_BASE_MOVE_AFTER=
# FORCE_ROUTINE_AUDIT=true — сохранить нарушения в БД при ручном запуске вне cron 10/17
FORCE_ROUTINE_AUDIT=false
LOG_LEVEL=INFO

# ============================================
# Уведомления
# ============================================
MANAGEMENT_CHAT_ID=chat12345
ADMIN_USER_ID=1
REPORT_CHAT_ID=22358
DEPT_CHAT_MAP_JSON={"60":22358,"46":22358,"42":22358,"44":22358,"50":22358,"66":22358}
ANALYST_CHUNK_SIZE=100

# ============================================
# Task Auditor (Бэк-Офис + РОП)
# ============================================
BACK_OFFICE_DEPT_ID=54
BACK_OFFICE_CHAT_ID=22358

# ============================================
# Owner Tracker (контакты-собственники)
# ============================================
CONTACT_OWNER_TYPE_ID=UC_2G0TD3
OWNER_KPI_SINCE=2026-06-01
OWNER_KPI_TARGET=10
OWNER_EXCLUDE_USER_IDS_JSON=[154, 116, 32, 174, 64, 46, 148]
RULES_ADVICE_JSON={"lead_rule_1":"обратить внимание на скорость квалификации лидов (статус «Новый» > 2 часов)","lead_rule_2":"указывать причину перевода лида в «Спам»","lead_rule_3":"указывать причину перевода лида в нецелевые","lead_new_over_24h":"квалифицировать лид «Новый» за 24 часа, иначе он уйдёт в «Общие лиды»","lead_missed_callback":"не пропускать входящие звонки по лидам без обратного","buyer_stage_1":"не задерживать сделки на этапе «Первый контакт» более 1 дня (стадия снята)","buyer_stage_2":"добавлять комментарии к сделкам на этапе «Подбор» (раз в 2 дня)","buyer_stage_3":"на «Первый показ» и «Повторный показ» — живое дело с датой не дальше 14 дней от этапа","buyer_stage_4":"устаревшее правило (стадии Переговоры/Дожим сняты с аудита)","buyer_stage_5":"на этапе «Отложенный спрос» держать запланированное дело в карточке","buyer_podbor_stale":"не держать сделки на этапе «Подбор» более 7 дней","buyer_ofer_comment":"на этапе «Офер» оставлять развёрнутый комментарий (от 30 символов)","buyer_lost_no_reason":"при переводе в «Сделка проиграна» указывать причину в комментарии","buyer_agent_no_comment":"при переводе в «Агент» оставлять комментарий","buyer_missed_callback":"не пропускать входящие звонки по сделкам без обратного","seller_stage_stale":"на этапах воронки Продавцы оставлять комментарий брокера/РОПа (на «Назначении встречи» — комментарий или непросроченное дело; на «Подготовке в рекламу» — комментарий или дело) в срок регламента (24ч / 3д / 7д)","seller_deferred_no_activity":"на этапе «Отложенная продажа» держать запланированное дело в карточке","seller_negotiations_max":"не держать сделки на «Переговорах» более 14 дней","seller_lost_no_reason":"при переводе в «Сделка проиграна» указывать причину в комментарии","seller_afina_id_missing":"на «Закрытая продажа» и «Поиск клиента» заполнять ID Афины","general_base_no_plan":"в «Общей базе» за 2 дня после переноса запланировать дело или написать комментарий с планом дальнейших действий"}

# ============================================
# Exclusive expiry (смарт-процесс «Эксклюзивы»)
# ============================================
EXCLUSIVE_ENTITY_TYPE_ID=1080
EXCLUSIVE_END_DATE_FIELD=ufCrm20_1784712129125
EXCLUSIVE_ADDRESS_FIELD=ufCrm20_1784712031409
EXCLUSIVE_EXPIRY_DAYS=7
# Точки напоминаний: за 7 дней, затем за 3, затем за 1 (без ежедневного спама)
EXCLUSIVE_EXPIRY_MILESTONES_JSON=[7, 3, 1]
EXCLUSIVE_SKIP_STAGE_IDS_JSON=["DT1080_26:SUCCESS", "DT1080_26:FAIL"]
# true — если cron пропустил точный день milestone, дошлёт один раз в окне до следующего
EXCLUSIVE_EXPIRY_CATCH_UP=true
# Всегда получают сообщение + ответственный по карточке
EXCLUSIVE_NOTIFY_USER_IDS_JSON=[32, 154, 378]
# Сообщения уходят от владельца вебхука (сейчас — ваш пользователь)
EXCLUSIVE_NOTIFY_FROM_USER_ID=154
# Опционально: отдельный webhook для отправки; пусто = B24_WEBHOOK_URL
EXCLUSIVE_NOTIFY_WEBHOOK_URL=

# Запрет смены «Источник» у контактов брокерами/РОПами (откат через snapshot)
CONTACT_SOURCE_LOCK_ENABLED=true
CONTACT_SOURCE_LOCK_LOOKBACK_MINUTES=30
CONTACT_SOURCE_LOCK_NOTIFY=true
# Кому писать об откате «Источник» (личный чат). 0 или пусто → ADMIN_USER_ID
CONTACT_SOURCE_LOCK_NOTIFY_USER_ID=154
CONTACT_SOURCE_LOCK_ROP_POSITION_SUBSTR_JSON=["РОП", "Руководитель отдела продаж"]
CONTACT_SOURCE_LOCK_EXCLUDE_USER_IDS_JSON=[]
CONTACT_SOURCE_LOCK_EXCLUDE_NAMES_JSON=["Агентство Недвижимости", "Asterisk1 1"]

# Запрет смены «Источник» у сделок воронки «Продавцы» (SELLERS_CATEGORY_ID)
DEAL_SOURCE_LOCK_ENABLED=true

# Автозаполнение + запрет смены «Базовая ставка» у сделок воронки «Покупатели»
BUYER_BASE_RATE_LOCK_ENABLED=true
BUYER_BASE_RATE_CSV=data/Мотивация брокеров 3 кв 2026 - Мотивация брокеров 3 кв 2026.csv

# Напоминания заполнить «Комиссия» (OPPORTUNITY) в воронке «Покупатели»
BUYER_COMMISSION_REMINDER_ENABLED=true
BUYER_COMMISSION_BROKER_INTERVAL_HOURS=2
BUYER_COMMISSION_ROP_INTERVAL_HOURS=1
BUYER_COMMISSION_REMIND_START_HOUR=9
BUYER_COMMISSION_DEADLINE_HOUR=19
# Смена ответственного на пул выключена: только напоминания
BUYER_COMMISSION_ENFORCE_ENABLED=false
BUYER_COMMISSION_POOL_USER_ID=1
# Broker CRM rating
# BROKER_RATING_SINCE=YYYY-MM-DD — копить рейтинг с этой даты (МСК 00:00); пусто = неделя/period_days
BROKER_RATING_SINCE=
BROKER_RATING_PERIOD_DAYS=7
BROKER_RATING_TOP_N=10
# Optional filter for company news in feed (empty = all important posts)
BROKER_RATING_NEWS_TAG=
# Override sales dept IDs (empty = OWNER_SALES_DEPT_IDS_JSON)
BROKER_RATING_SALES_DEPT_IDS_JSON=
# JSON overrides for weights/penalties (see plans/broker-rating-plan.md)
BROKER_RATING_WEIGHTS_JSON={}
# Исключить из рейтинга (не ведут CRM): user ID в Bitrix24
BROKER_RATING_EXCLUDE_USER_IDS_JSON=[108]

# Контроль качества лидов Спам/Нецелевой (слитые / неверная квалификация)
LEAD_QUALITY_ENABLED=true
LEAD_QUALITY_SINCE=2026-07-01
LEAD_QUALITY_CHUNK_SIZE=40

# ИИ-агент восстановления состояния клиента (покупатели, v1)
CLIENT_STATE_ENABLED=false
CLIENT_STATE_TRANSCRIPT_RETRY_HOURS=1

# ============================================================================
# Аналитическая витрина и веб-дашборд (pars.afina-crm.ru/dashboard)
# ============================================================================

# --- Витрина (ETL) ---
# Отдельный файл БД: витрину пишет только ETL, а data/violations.db делят
# 14 cron-задач аудита. Смешивать их значит ловить «database is locked».
ANALYTICS_DB_PATH=data/analytics.db
# Глубина истории при первичной загрузке (--backfill). Вычисляется один раз
# и фиксируется: пересчёт «сегодня минус N месяцев» на каждом прогоне
# разошёлся бы с уже загруженными данными.
ANALYTICS_MONTHS_BACK=12
# Лимит портала — 2 запроса/сек. Поднимать выше не стоит.
ANALYTICS_RATE_LIMIT_RPS=2.0
# Перекрытие при инкременте: без него теряются записи, изменённые в ту же
# секунду, что и watermark. Повторная загрузка безвредна — она идёт upsert-ом.
ANALYTICS_ETL_OVERLAP_MINUTES=5
# Валюта денежных метрик дашборда. Сделки в других валютах в суммы не входят
# и показываются отдельной строкой на «Качестве данных»: курса у витрины нет,
# и сложить доллары с рублями значит напечатать неверное число со знаком ₽.
ANALYTICS_BASE_CURRENCY=RUB
# Поле суммы по воронкам, если где-то это не OPPORTUNITY.
# Пример: {"0": "UF_CRM_1780911079"}. Пусто → OPPORTUNITY во всех воронках.
ANALYTICS_AMOUNT_FIELD_BY_CATEGORY_JSON={}
# Переопределение семантики стадии, если воронка объявила успешной стадию,
# которую по идентификатору не угадать. Пример: {"C18:UC_RUCRAH": "won"}.
ANALYTICS_STAGE_SEMANTIC_OVERRIDES_JSON={}

# --- Дашборд ---
# ОБЯЗАТЕЛЬНО. Без него сервис не стартует — и это намеренно: генерировать
# ключ при запуске значило бы разлогинивать всех при каждом рестарте.
# Сгенерировать: python src/web/manage.py gen-secret
DASHBOARD_SECRET_KEY=
# Слушаем только localhost. Наружу выставляет nginx, он же терминирует TLS.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_BASE_PATH=/dashboard
# Абсолютный срок сессии и срок простоя. Первый ограничивает украденную куку,
# второй закрывает забытую вкладку на чужом устройстве.
DASHBOARD_SESSION_TTL_HOURS=12
DASHBOARD_SESSION_IDLE_HOURS=2
# false — ТОЛЬКО для локальной отладки по http. В проде обязательно true:
# без Secure кука уходит по незашифрованному каналу.
DASHBOARD_COOKIE_SECURE=true
# Защита от подбора: блокировка после N неудач за окно, по логину и по адресу.
DASHBOARD_LOGIN_MAX_ATTEMPTS=5
DASHBOARD_LOGIN_LOCKOUT_MINUTES=15

# ============================================================================
# Афина CRM: раздел «Объекты» в дашборде
# ============================================================================
# Дашборд читает объекты из Афины по её read-only витрине
# /api/public/dashboard/*. Ключ тот же, что у публичного каталога сайта, но
# контракт другой: статусы, причины снятия и даты событий каталог не отдаёт.
AFINA_API_BASE_URL=https://afina-crm.ru
# Значение X-API-Key (PUBLIC_API_KEY на стороне Афины). Пусто → раздел
# «Объекты» не показывается и в навигации его нет: пустая страница с ошибкой
# хуже, чем отсутствие пункта меню.
AFINA_API_KEY=
# Страница дашборда ждёт ответ Афины синхронно, поэтому таймаут короткий:
# зависший внешний сервис не должен держать воркер uvicorn.
AFINA_API_TIMEOUT_SECONDS=10.0
# Размер страницы выдачи. Потолок Афины — 100, больше просить нельзя.
AFINA_API_PAGE_SIZE=50
